{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "resourceClass": "medium",
      "android": {
        "gradleCommand": ":app:bundleRelease -x lint"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
